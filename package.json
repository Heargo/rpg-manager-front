{
  "name": "panel",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/ng-with-env.mjs serve",
    "build": "node scripts/ng-with-env.mjs build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "sprites:sets": "esbuild scripts/generate-sprite-sets.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/generate-sprite-sets.mjs && node node_modules/.cache/generate-sprite-sets.mjs"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@angular/service-worker": "^22.2.5",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@jsverse/transloco": "^8.4.0",
    "@netlify/blobs": "^11.1.8",
    "@openng/icons": "^1.0.0",
    "@openng/optimus-ui": "^2.0.2",
    "@openng/optimus-ui-themes": "^2.0.2",
    "idb": "^8.0.4",
    "jsqr": "1.4.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "three": "^0.187.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.187.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
