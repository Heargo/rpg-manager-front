    "townsfolk": {
      "descriptions": [
        "{g:Il|Elle} vit de peu, à l'écart des grandes routes de {place}.",
        "{g:Il|Elle} connaît tout le monde au village et ne garde rien pour {g:lui|elle}.",
        "{g:Il|Elle} aurait croisé {creature} un soir de brume."
      ]
    },
