          "text": "paysanne",
          "gender": "f"
        }
      ],
      "descriptions": [
        "{g:Il|Elle} cultive un lopin de terre près de {place}, les mains calleuses et le dos voûté.",
        "{g:Il|Elle} parle encore de {event} avec des trémolos dans la voix.",
        "{g:Il|Elle} garde une fourche à portée de main depuis qu'on a vu {creature} rôder."
      ]
    },
    "noble": {
      "nouns": [
        {
          "text": "seigneur",
          "gender": "m"
        },
        {
          "text": "dame",
          "gender": "f"
        }
      ],
      "names": ["{noun} {given}", "{given} {epithet}"],
      "descriptions": [
        "{g:Il|Elle} porte de beaux habits, mais ses terres de {place} périclitent.",
        "{g:Il|Elle} doit une fière chandelle à {owner} et n'aime pas qu'on le rappelle.",
        "{g:Il|Elle} sourit poliment et n'oublie jamais un affront."
      ]
    },
    "scholar": {
      "nouns": [
        {
          "text": "érudit",
          "gender": "m"
        },
        {
          "text": "érudite",
          "gender": "f"
        }
      ],
      "names": ["{given}, {noun}", "{given} {epithet}"],
      "descriptions": [
        "{g:Il|Elle} passe ses nuits sur de vieux grimoires qui parlent de {event}.",
        "{g:Il|Elle} cherche depuis des années ce qu'{g:il|elle} a perdu près de {place}.",
        "{g:Il|Elle} a le nez dans ses notes et oublie de manger."
      ]
    },
    "priest": {
      "nouns": [
        {
          "text": "prêtre",
          "gender": "m"
        },
        {
          "text": "prêtresse",
          "gender": "f"
        }
      ],
      "names": ["{noun} {given}", "{given} {epithet}"],
      "descriptions": [
        "{g:Il|Elle} veille sur un petit sanctuaire de {place} et écoute plus qu'{g:il|elle} ne parle.",
        "{g:Il|Elle} a béni plus de morts que de naissances depuis {event}.",
        "{g:Il|Elle} prie pour les gens laissés sans abri par {creature}."
      ]
    },
    "trader": {
      "descriptions": [
        "{g:Il|Elle} compte ses pièces deux fois, par habitude.",
        "{g:Il|Elle} a de bonnes affaires à proposer, et de meilleures à cacher.",
        "Ses affaires {g:le|la} mènent jusqu'à {place} et au-delà."
      ]
    },
