      "names": ["{given}, {noun}", "{given} {epithet}"],
      "descriptions": [
        "{g:Il|Elle} tient un étal bien rangé et connaît le prix de chaque chose.",
        "{g:Il|Elle} ramène des marchandises rares de {place}, à des prix qui ne le sont pas moins.",
        "{g:Il|Elle} a perdu une cargaison entière après avoir croisé {creature}."
      ]
