  "descriptions": {
    "active": [
      "Un geste éprouvé qui récompense la main sûre.",
      "Née de cent escarmouches, elle met fin aux combats en un clin d'œil.",
      "Elle coûte cher, mais personne ne l'oublie.",
      "Enseignée seulement à ceux qui ont gagné la confiance des anciens.",
      "Une technique spectaculaire au but très pratique.",
      "Puise dans les réserves de son auteur pour renverser la situation.",
      "Facile à apprendre, infinie à perfectionner.",
      "Souvent la dernière chose que l'ennemi voit venir.",
      "Appréciée des vétérans qui aiment finir ce qu'ils commencent.",
      "Elle demande l'esprit clair et un réflexe vif."
    ],
    "passive": [
      "Façonne discrètement tout ce que fait son possesseur.",
      "Des années de pratique en ont fait une seconde nature.",
      "Personne ne la remarque avant qu'elle ne sauve la mise.",
      "Un don durable laissé par un long entraînement.",
      "Inutile de l'invoquer : elle est simplement là.",
      "Un trait qui se renforce à chaque épreuve.",
      "Influence la manière dont son possesseur affronte le danger.",
      "Une vieille habitude devenue talent.",
      "Ceux qui la possèdent en parlent rarement.",
      "Acquise à la dure et jamais oubliée."
    ]
  }
